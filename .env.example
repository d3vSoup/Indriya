# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── Groq (Sentence Simplification + Lesson Summarisation) ────────────────────
# Fastest open-source LLM inference. Free tier is very generous.
# Get from: https://console.groq.com/keys → Create API Key  (starts with gsk_...)
GROQ_API_KEY=your_groq_api_key_here

# ── Together AI (Qwen3-VL — Board OCR / Vision) ───────────────────────────────
# Open-source SOTA vision model. $25 free credits on signup.
# Get from: https://www.together.ai/ → Settings → API Keys  (starts with tgp_...)
TOGETHER_API_KEY=your_together_api_key_here

# ── Gemini (Fallback Vision OCR) ─────────────────────────────────────────────
# Used as fallback if Together AI is unavailable or fails.
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Vercel Deployment ──────────────────────────────────────────────────────────
VERCEL_URL=your_vercel_url_here
VERCEL_DASHBOARD_URL=your_vercel_dashboard_url_here

# ── Tavily (Feature A: "Ask the Web" — ISL Gloss Lookup) ─────────────────────
# Real-time web search for deaf students. API key is STRICTLY server-side only —
# never exposed to frontend. Get a free key at: https://app.tavily.com
TAVILY_API_KEY=

# ── n8n (Feature B: Parent Notifications) ─────────────────────────────────────
# Your n8n webhook URL (the public URL of your Webhook Trigger node).
# This is a URL, not a credential — it is safely exposed via /config to the frontend.
# Cloud trial: https://n8n.io  |  Local: npx n8n  (runs on http://localhost:5678)
N8N_WEBHOOK_URL=

# ── n8n Notification Recipient (Feature B: Parent Notifications) ──────────────
# The email address the n8n workflow will deliver the lesson summary to.
# Backend-only — NEVER exposed to the frontend.
# Set to the parent/guardian email your team leader configured in the n8n Send Email node.
NOTIFY_EMAIL=